# ===== 必改 =====
INTERNETBOARD_IMAGE=milesxia/internetboard:latest
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string

# Lucky 使用 HTTPS 反代且不需要通过局域网 HTTP 登录时可改 true
SESSION_HTTPS_ONLY=false
TZ=Asia/Shanghai
HOST_PORT=8733

# ===== 双模型 =====
# 最终深度判断：Qwen3.8 27B / 18GB
OLLAMA_MODEL=qwen3.8:27b-q4_K_M
# 大量原文分块提炼：纯文本 Qwen3 4B / 2.5GB，尽量放入 GTX1650
OLLAMA_EXTRACT_MODEL=qwen3:4b-instruct-2507-q4_K_M
AUTO_PULL_MODEL=true
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_GPU=4
OLLAMA_EXTRACT_NUM_GPU=99
OLLAMA_NUM_THREAD=6
OLLAMA_EXTRACT_NUM_THREAD=4
OLLAMA_FINAL_THINK=medium

# ===== 完整性流水线 =====
AI_CHUNK_TOKENS=2400
AI_CHUNK_OVERLAP_TOKENS=180
AI_EXTRACT_PREDICT=320
AI_REDUCE_TOKENS=3200
AI_REDUCE_PREDICT=500
AI_FINAL_TOKENS=5000
AI_FINAL_PREDICT=1200
MAX_HISTORY_CLAIMS=60
BACKFILL_EVIDENCE_PER_RUN=3

# ===== 长期知识检索 =====
# 0.6B 向量模型只在单专题有效 Claim 达到阈值后按需下载/使用
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
ENABLE_EMBEDDINGS=true
SEMANTIC_RAG_MIN_CLAIMS=200
EMBEDDING_BATCH_SIZE=24
SEMANTIC_CANDIDATE_LIMIT=80

# ===== 深度研究 / 队列 =====
ENABLE_GAP_SEARCH=true
MAX_FOLLOWUP_QUERIES=2
QUEUE_POLL_SECONDS=2
QUEUE_MAX_ATTEMPTS=3
AUTO_BACKUP_KEEP=7

# ===== NAS保护 =====
APP_MEMORY_LIMIT=3g
OLLAMA_MEMORY_LIMIT=30g
# 预留约384MiB VRAM给CUDA运行时/缓存
OLLAMA_GPU_OVERHEAD=402653184

# ===== 联网 =====
MAX_FETCH_CONCURRENCY=3
MAX_SEARCH_RESULTS=8
MAX_CANDIDATES_PER_TOPIC=20
REQUEST_TIMEOUT=25
SEARXNG_URL=
ARCHIVE_FULLTEXT=true
