# ===== 必改 =====
INTELBOARD_IMAGE=YOUR_DOCKERHUB_USERNAME/intelboard:latest
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string

# ===== QNAP =====
TZ=Asia/Shanghai
HOST_PORT=8733

# ===== 本地模型 =====
# auto 针对你的 TS-673A + 40GB RAM：默认选 Qwen3 30B-A3B Instruct Q4_K_M（约19GB）
# 若希望更快可手动改为 qwen3.5:9b
OLLAMA_MODEL=auto
AUTO_PULL_MODEL=true
OLLAMA_NUM_CTX=8192

# ===== 性能保护：Ryzen V1500B + GTX1650 4GB =====
MAX_FETCH_CONCURRENCY=3
MAX_SEARCH_RESULTS=8
MAX_CANDIDATES_PER_TOPIC=20
AI_CONTEXT_CHARS=18000
REQUEST_TIMEOUT=25

# ===== 可选搜索后端 =====
# 不填时直接使用内置联网搜索；如果以后自建 SearXNG，可填 http://searxng:8080
SEARXNG_URL=

# 保存抓取的网页/PDF全文到 /share/Container/intelboard/data/archive
ARCHIVE_FULLTEXT=true
