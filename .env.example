COMPOSE_PROJECT_NAME=internetboard
APP_ROOT=/share/Container/internetboard
TZ=Asia/Shanghai
WEB_PORT=8733
POSTGRES_DB=internetboard
POSTGRES_USER=internetboard
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
OLLAMA_MODEL=qwen3.8:27b-q4_K_M
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=-1
# Aggressive GTX1650 + 40GB RAM policy: GPU first, RAM spillover through CUDA UVM.
GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
LLAMA_ARG_LOAD_MODE=mmap
LLAMA_ARG_N_GPU_LAYERS=all
LLAMA_ARG_FIT=off
LLAMA_ARG_FIT_TARGET=0
LLAMA_ARG_MMPROJ_OFFLOAD=true
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_JSON_RETRIES=3
MAX_SEARCH_ROUNDS=2
MAX_QUERIES_PER_ROUND=6
MAX_RESULTS_PER_QUERY=8
MAX_SOURCES_PER_RUN=8
MAX_TOTAL_AI_CHUNKS=12
MAX_AI_CHUNKS_PER_SOURCE=3
VISUAL_ENABLED=true
VISUAL_MAX_ASSETS_PER_SOURCE=2
VISUAL_MAX_ASSETS_PER_RUN=4
VISUAL_MAX_CANDIDATES_PER_SOURCE=10
VISUAL_MAX_IMAGE_BYTES=8388608
VISUAL_MIN_WIDTH=280
VISUAL_MIN_HEIGHT=160
VISUAL_MIN_PIXELS=100000
VISUAL_MAX_DIMENSION=1600
VISUAL_REQUEST_TIMEOUT_SECONDS=30
VISUAL_PDF_MAX_PAGES=2
VISUAL_PDF_TEXT_THRESHOLD=350
VISUAL_PDF_SCALE=1.4
VISUAL_NUM_PREDICT=1000
CHUNK_CHARS=5500
CHUNK_OVERLAP_CHARS=500
ALLOW_PRIVATE_URLS=false
SEARXNG_URL=
SCHEDULER_HOUR=3
SCHEDULER_MINUTE=0
WEBSITE_WATCH_MINUTES=60
RUN_HEARTBEAT_INTERVAL_SECONDS=15
RUN_HEARTBEAT_TTL_SECONDS=60
RUN_LOCK_TTL_SECONDS=90
RUN_QUEUE_MARKER_TTL_SECONDS=180
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TTL_SECONDS=50
RUNTIME_WATCHDOG_SECONDS=60
OLLAMA_PIN_MODEL=true
# BEGIN INTERNETBOARD V4.11 SHANGHAI LOCAL
LOCAL_INTEL_TIME_RANGE=day
LOCAL_INTEL_RESULTS_PER_QUERY=3
LOCAL_INTEL_MAX_TOPICS=12
LOCAL_INTEL_MAX_QUERIES_PER_TOPIC=40
LOCAL_INTEL_FETCH_TIMEOUT_SECONDS=20
LOCAL_INTEL_QUERY_DELAY_SECONDS=0.35
LOCAL_INTEL_MIN_SCORE=60
LOCAL_INTEL_MAX_CONTENT_CHARS=12000
DAILY_REPORT_NOT_BEFORE_MINUTE=15
# END INTERNETBOARD V4.11 SHANGHAI LOCAL
